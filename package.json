{
  "name": "scrum-poker",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm exec vitest run --config vitest.config.mjs && pnpm --filter @scrum-poker/protocol test && pnpm --filter @scrum-poker/server test && pnpm --filter @scrum-poker/web test",
    "typecheck": "pnpm -r typecheck",
    "lint:no-sockets": "node scripts/no-sockets.mjs",
    "test:e2e": "pnpm exec playwright test",
    "test:load": "node scripts/not-implemented.mjs test:load"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "cross-env": "^10.0.0",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "start-server-and-test": "^2.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
