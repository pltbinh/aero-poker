# Production runtime for the isolated Scrum Poker backend on Node.js 20.
# Copy this file to /opt/scrum-poker/apps/server/.env and set the Pages owner.
NODE_ENV=production
HOST=127.0.0.1
PORT=4100
CORS_ORIGINS=https://<github-owner>.github.io
EGRESS_DISABLED_FILE=/var/lib/scrum-poker/egress-disabled
