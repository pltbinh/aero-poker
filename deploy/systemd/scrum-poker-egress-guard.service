[Unit]
Description=Scrum Poker shared-VM egress safety guard
Documentation=file:///opt/scrum-poker/docs/operations.md
After=local-fs.target
ConditionPathExists=/usr/local/lib/scrum-poker/egress-guard.sh

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/lib/scrum-poker/egress-guard.sh
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
UMask=0022
ReadWritePaths=/var/lib/scrum-poker
